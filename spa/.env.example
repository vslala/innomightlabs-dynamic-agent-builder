# Subscription Backend: 'local' (default) or 'api'
VITE_SUBSCRIPTION_BACKEND=local

# API Base URL (required when VITE_SUBSCRIPTION_BACKEND=api)
VITE_API_BASE_URL=https://api.example.com

# Feature flags
# Show the "Agent activity" panel of tools a turn ran (never shown for Ila). Defaults to true.
VITE_SHOW_TOOL_ACTIVITY=true
