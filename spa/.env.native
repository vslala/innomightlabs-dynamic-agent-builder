# The store apps (`yarn build:native`, `yarn cap:sync`). A VITE_API_BASE_URL in the shell is ignored here (see
# vite.config.ts); to point a simulator at a local API: NATIVE_API_BASE_URL=http://localhost:8000 yarn cap:sync
VITE_PLATFORM=native
VITE_API_BASE_URL=https://api.innomightlabs.com
# Must match NATIVE_APP_SCHEME (API), CFBundleURLTypes (ios/App/App/Info.plist) and the Android intent-filter.
VITE_NATIVE_APP_SCHEME=com.innomightlabs.app
