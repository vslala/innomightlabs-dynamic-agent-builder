FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip groff less \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) aws_arch="x86_64" ;; \
    arm64) aws_arch="aarch64" ;; \
    *) echo "Unsupported architecture for AWS CLI: $arch" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}.zip" -o "/tmp/awscliv2.zip" \
  && unzip /tmp/awscliv2.zip -d /tmp \
  && /tmp/aws/install \
  && rm -rf /tmp/aws /tmp/awscliv2.zip

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY main.py ./
COPY src ./src

RUN useradd --system --home-dir /tmp/infra-cli-runner --shell /usr/sbin/nologin runner \
  && mkdir -p /tmp/infra-cli-runner \
  && chown runner:runner /tmp/infra-cli-runner \
  && chmod 700 /tmp/infra-cli-runner \
  && chmod 755 /var/tmp

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

USER runner

CMD ["sh", "-c", "hypercorn main:app --bind [::]:${PORT:-8080}"]
